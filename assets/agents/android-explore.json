{
  "name": "android-explore",
  "description": "Read-only code explorer. Maps files, symbols, call paths, and impact for a parent-provided scope using CodeGraph first, and returns a compressed path:line handoff.",
  "mode": "subagent",
  "profile": "scout",
  "hidden": true,
  "steps": null,
  "rules": [
    [
      "*",
      "*",
      "deny"
    ],
    [
      "read",
      "*",
      "allow"
    ],
    [
      "read",
      "*.env",
      "ask"
    ],
    [
      "read",
      "*.env.*",
      "ask"
    ],
    [
      "read",
      "*.env.example",
      "allow"
    ],
    [
      "grep",
      "*",
      "allow"
    ],
    [
      "glob",
      "*",
      "allow"
    ],
    [
      "list",
      "*",
      "allow"
    ],
    [
      "codegraph_*",
      "*",
      "allow"
    ],
    [
      "firebase_*",
      "*",
      "allow"
    ],
    [
      "execute",
      "*",
      "allow"
    ],
    [
      "shell",
      "*",
      "deny"
    ],
    [
      "shell",
      "unzip -l *",
      "allow"
    ],
    [
      "shell",
      "unzip -p *",
      "allow"
    ],
    [
      "external_directory",
      "@@OPENCODE_TMP@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@OPENCODE_TOOL_OUTPUT@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@GRADLE_CACHES@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@ANDROID_SDK@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@DELIVERABLES@@/*",
      "allow"
    ]
  ]
}
