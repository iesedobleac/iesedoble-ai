{
  "name": "android-orchestrator",
  "description": "Primary orchestrator for small and medium Android tasks without SDD phases. Checks memory once, keeps a thin context, delegates exploration and implementation, reviews on request, and owns commits.",
  "mode": "primary",
  "profile": "planner",
  "hidden": false,
  "steps": null,
  "rules": [
    [
      "*",
      "*",
      "deny"
    ],
    [
      "read",
      "*",
      "allow"
    ],
    [
      "read",
      "*.env",
      "ask"
    ],
    [
      "read",
      "*.env.*",
      "ask"
    ],
    [
      "read",
      "*.env.example",
      "allow"
    ],
    [
      "grep",
      "*",
      "allow"
    ],
    [
      "glob",
      "*",
      "allow"
    ],
    [
      "list",
      "*",
      "allow"
    ],
    [
      "codegraph_*",
      "*",
      "allow"
    ],
    [
      "execute",
      "*",
      "allow"
    ],
    [
      "todowrite",
      "*",
      "allow"
    ],
    [
      "question",
      "*",
      "allow"
    ],
    [
      "edit",
      "*",
      "ask"
    ],
    [
      "webfetch",
      "*",
      "ask"
    ],
    [
      "engram_mem_search",
      "*",
      "allow"
    ],
    [
      "engram_mem_get_observation",
      "*",
      "allow"
    ],
    [
      "engram_mem_context",
      "*",
      "allow"
    ],
    [
      "engram_mem_save",
      "*",
      "allow"
    ],
    [
      "engram_mem_update",
      "*",
      "allow"
    ],
    [
      "engram_mem_judge",
      "*",
      "allow"
    ],
    [
      "engram_mem_compare",
      "*",
      "allow"
    ],
    [
      "engram_mem_session_summary",
      "*",
      "allow"
    ],
    [
      "engram_mem_current_project",
      "*",
      "allow"
    ],
    [
      "engram_mem_suggest_topic_key",
      "*",
      "allow"
    ],
    [
      "skill",
      "*",
      "deny"
    ],
    [
      "skill",
      "*-commits",
      "allow"
    ],
    [
      "skill",
      "*-branches",
      "allow"
    ],
    [
      "skill",
      "*-pull-requests",
      "allow"
    ],
    [
      "skill",
      "*-code-style",
      "allow"
    ],
    [
      "subagent",
      "*",
      "deny"
    ],
    [
      "subagent",
      "android-explore",
      "allow"
    ],
    [
      "subagent",
      "android-research",
      "allow"
    ],
    [
      "subagent",
      "android-worker",
      "allow"
    ],
    [
      "subagent",
      "android-review",
      "allow"
    ],
    [
      "subagent",
      "android-device",
      "allow"
    ],
    [
      "shell",
      "*",
      "deny"
    ],
    [
      "shell",
      "git status *",
      "allow"
    ],
    [
      "shell",
      "git diff *",
      "allow"
    ],
    [
      "shell",
      "git log *",
      "allow"
    ],
    [
      "shell",
      "git show *",
      "allow"
    ],
    [
      "shell",
      "git branch *",
      "allow"
    ],
    [
      "shell",
      "git rev-parse *",
      "allow"
    ],
    [
      "shell",
      "git ls-files *",
      "allow"
    ],
    [
      "shell",
      "git merge-base *",
      "allow"
    ],
    [
      "shell",
      "git fetch *",
      "allow"
    ],
    [
      "shell",
      "git verify-commit *",
      "allow"
    ],
    [
      "shell",
      "git add *",
      "allow"
    ],
    [
      "shell",
      "git commit *",
      "allow"
    ],
    [
      "shell",
      "git switch --no-track -c *",
      "allow"
    ],
    [
      "shell",
      "gh pr *",
      "allow"
    ],
    [
      "shell",
      "gh sherpa *",
      "allow"
    ],
    [
      "shell",
      "gh label list *",
      "allow"
    ],
    [
      "shell",
      "git push *",
      "deny"
    ],
    [
      "external_directory",
      "@@OPENCODE_TMP@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@OPENCODE_TOOL_OUTPUT@@/*",
      "allow"
    ],
    [
      "external_directory",
      "@@DELIVERABLES@@/*",
      "allow"
    ]
  ]
}
